FROM ubuntu:26.04

# We want this to be an env var that only persists during the build step but is
# not part of the final image, so we're using ARG here instead of ENV which
# would keep this permanently as part of the final built image.
#
# All other similar build-time env vars are also using ARG instead of VAR.
ARG DEBIAN_FRONTEND=noninteractive

# https://github.com/hadolint/hadolint/wiki/DL4006
# https://docs.docker.com/develop/develop-images/instructions/#using-pipes
#
# Without setting this option, container build may only evaluate the success or
# failure of the last command in a sequence of piped commands, so an earlier
# command failing may be silentl ignored.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Need to install curl first to get the Google Chrome APT key below.
# Ubuntu 26.04 base image has neither `curl` nor `wget`.
#
# Adding `ca-certificates` and `gpg` explicitly so we can keep
# `--no-install-recommends` but still keep the minimal set of required packages
# to make the following commands work properly.
RUN apt-get update -qq > /dev/null \
    && apt-get install -qq -y --no-install-recommends \
        ca-certificates \
        curl \
        gpg \
        > /dev/null \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up Google's signing key and repository for Google Chrome.
# See https://www.google.com/linuxrepositories/ for more info.
#
# We need a browser in the container for Antigravity login; just installing the
# Firefox or Chromium from Ubuntu APT repo doesn't actually work as it doesn't
# set them up as browsers that `xdg-open` will recognize for handling HTTPS
# URLs. Alternatively, installing the Snap version is problematic inside containers.
#
# Thus, we install it manually from Google's APT repo.
ARG GOOGLE_KEY="/etc/apt/trusted.gpg.d/google.asc"
RUN curl -fsSL "https://dl.google.com/linux/linux_signing_key.pub" \
    | tee "${GOOGLE_KEY}" > /dev/null
RUN echo "deb [arch=amd64 signed-by=${GOOGLE_KEY}] https://dl.google.com/linux/chrome/deb/ stable main" \
    | tee "/etc/apt/sources.list.d/google-chrome.list" > /dev/null

# Install Antigravity dependencies.
#
# We are going to run another `apt-get install` below, so let's not clean up
# here so we don't need to run `apt-get update` immediately aftwards to get the
# same data back.
#
# hadolint ignore=DL3009
RUN apt-get update -qq > /dev/null \
    && apt-get install -qq -y --no-install-recommends \
        google-chrome-stable \
        libasound2t64 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libegl1 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libx11-xcb1 \
        > /dev/null

# Install development tools.
RUN apt-get install -qq -y --no-install-recommends \
        clang \
        clangd \
        gdb \
        git \
        less \
        meson \
        sudo \
        tmux \
        > /dev/null \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu comes with a user account `ubuntu` with uid=1000, gid=1000.
# If this matches your user account, you're all set with this config.
ARG UNAME ubuntu
RUN echo "${UNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
ARG HOME="/home/${UNAME}"
WORKDIR "${HOME}"
VOLUME "${HOME}"
VOLUME "${HOME}/projects"
USER "${UNAME}"

# Install Antigravity IDE or app outside of the container so it can be updated
# easily without having to rebuild the container every time.
VOLUME "/opt/antigravity-ide"
VOLUME "/opt/antigravity"

# Set this to "ide" or "app" and map at least the required volume above.
ENV ANTIGRAVITY ide

# This file is in `home` subdirectory and mapped as the user's home directory
# inside the container.
CMD ["./run-antigravity.sh"]
